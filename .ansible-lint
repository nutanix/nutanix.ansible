---
# Red Hat Ansible Collection Certification .ansible-lint file
# Taken from:
# https://github.com/ansible-collections/partner-certification-requirements
profile: production

exclude_paths:
  - tests/integration
  - tests/unit
  - extensions/molecule
  - changelogs
  - docs
  - .ansible
  - .github

warn_list:
  - no-log-password
